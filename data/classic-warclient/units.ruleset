flags="HasNoZOC","FieldUnit","Nuclear","OneAttack"
helptext="You can build Nuclear units when you have the required advance, and the Manhattan Project wonder has been built by any player.","On impact, the blast will destroy any unit in an area 3 tiles wide (3x3 squares for rectangular grids), including friendly units. Any city within the blast area loses half its population, and land tiles within the blast area are subject to nuclear fallout.","Nuclear fallout reduces tile output and increases the risk of global nuclear winter; see the help on Fallout.","TIP 1:  Nuking the ocean will not generate fallout, and is a most effective (but expensive!!) way of getting rid of enemy ships.","TIP 2:  You may be involved in a situation where you've invaded an enemy country en masse, but the enemy cities are too strong. Before using a Nuclear unit, assemble a gang of Settlers, Workers, and/or Engineers next to the city and have them ready to fix the fallout on the same turn it occurs!  This minimizes the chance of nuclear winter.  Eco-friendly nukes!"

[unit_44]
name=_("Diplomat")
class="Land"
reqs={"type","name","range"
"Tech","Writing","Player"
}
obsolete_by="Spy"
